<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_you"
                    android:textColor="?attr/colorInkSoft"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/your_name"
                    android:inputType="textCapWords"
                    android:maxLength="24"
                    android:padding="12dp"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorInkDim" />

                <EditText
                    android:id="@+id/etPlate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/plate"
                    android:inputType="textCapCharacters"
                    android:maxLength="8"
                    android:padding="12dp"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorInkDim" />

                <EditText
                    android:id="@+id/etDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/detail_hint"
                    android:inputType="text"
                    android:maxLength="40"
                    android:padding="12dp"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorInkDim" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/photo"
                    android:textColor="?attr/colorInkSoft"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPhoto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/choose_photo" />

                    <Button
                        android:id="@+id/btnPhotoClear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/remove_photo" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/section_system"
                    android:textColor="?attr/colorInkSoft"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/notifications_access" />

                <Button
                    android:id="@+id/btnLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/location_access" />

                <Button
                    android:id="@+id/btnHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/set_home" />

                <Button
                    android:id="@+id/btnAndroidSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/android_settings" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/oil_title"
                    android:textColor="?attr/colorInkSoft"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/oil_help"
                    android:textColor="?attr/colorInkDim"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/oil_date_label"
                    android:textColor="?attr/colorInk"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/oilDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="12dp"
                    android:text="@string/pick_date"
                    android:textColor="?attr/colorInkDim" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/oil_km_label"
                    android:textColor="?attr/colorInk"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etKm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/oil_km"
                    android:inputType="number"
                    android:maxLength="7"
                    android:padding="12dp"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorInkDim" />

                <Button
                    android:id="@+id/btnClearOil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_oil" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tire_title"
                    android:textColor="?attr/colorInkSoft"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tires_help"
                    android:textColor="?attr/colorInkDim"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etTires"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/tires_hint"
                    android:inputType="textCapSentences"
                    android:maxLength="40"
                    android:padding="12dp"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorInkDim" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/section_pico"
                    android:textColor="?attr/colorInkSoft"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/pico_help"
                    android:textColor="?attr/colorInkDim"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etMon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/monday"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="?attr/colorInk"
                        android:textColorHint="?attr/colorInkDim" />

                    <EditText
                        android:id="@+id/etTue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/tuesday"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="?attr/colorInk"
                        android:textColorHint="?attr/colorInkDim" />

                    <EditText
                        android:id="@+id/etWed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/wednesday"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="?attr/colorInk"
                        android:textColorHint="?attr/colorInkDim" />

                    <EditText
                        android:id="@+id/etThu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/thursday"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="?attr/colorInk"
                        android:textColorHint="?attr/colorInkDim" />

                    <EditText
                        android:id="@+id/etFri"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="@string/friday"
                        android:inputType="text"
                        android:padding="10dp"
                        android:textColor="?attr/colorInk"
                        android:textColorHint="?attr/colorInkDim" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hours_hint"
                    android:inputType="text"
                    android:maxLength="48"
                    android:padding="12dp"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorInkDim" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/save" />
</LinearLayout>
